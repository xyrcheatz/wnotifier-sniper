{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wnotifier-cloud-sniper",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "browser": {
    "binding": "BROWSER"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wnotifier-cloud-db",
      "database_id": "090d8cca-3a33-4d51-b251-6911c572070b",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "SNIPER",
        "class_name": "SniperController"
      }
    ]
  },

  "exports": {
    "SniperController": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "observability": {
    "enabled": true
  }
}
